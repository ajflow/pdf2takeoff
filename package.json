{
  "name": "pdf2takeoff",
  "version": "0.1.0",
  "description": "Free, open-source construction takeoff engine: a Node CLI and MCP server for quantity takeoff from PDF drawings, scans and DXF files (scale, lengths, areas, symbol counts, Excel and CSV export, markups that open in Bluebeam). Runs locally. Browser app: https://pdf2takeoff.com",
  "type": "module",
  "bin": {
    "pdf2takeoff": "bin/pdf2takeoff.js"
  },
  "files": [
    "bin",
    "dist-node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "typecheck:engine": "tsc --noEmit -p src/engine && node scripts/check-engine.mjs && node scripts/run-checks.mjs scripts/check-fill.mjs scripts/check-detector.mjs scripts/check-detector-node.mjs scripts/check-ocr.mjs scripts/check-scale.mjs scripts/check-dimensions.mjs scripts/check-vector.mjs scripts/check-raster-input.mjs scripts/check-inputs.mjs scripts/check-export.mjs scripts/check-scan.mjs scripts/check-openings.mjs scripts/check-scaled-bench.mjs scripts/check-inventory.mjs",
    "build": "npm run typecheck:engine && tsc --noEmit && vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "prepack": "npm run build:node",
    "prepare": "npm run build:node",
    "check:deploy": "node scripts/check-deploy.mjs",
    "cli": "node bin/pdf2takeoff.js",
    "preview": "vite preview",
    "sample": "node scripts/make-sample.mjs",
    "soak": "node scripts/make-soak.mjs",
    "bench": "node --experimental-strip-types scripts/takeoff-bench.mjs",
    "bench:rooms": "node --experimental-strip-types scripts/room-bench.mjs",
    "bench:ledger": "node --experimental-strip-types scripts/bench-ledger.mjs",
    "bench:scaled": "node --experimental-strip-types scripts/scaled-drawing-bench.mjs"
  },
  "keywords": [
    "construction",
    "takeoff",
    "construction-takeoff",
    "quantity-takeoff",
    "construction-estimating",
    "estimating",
    "quantity-surveying",
    "bluebeam-alternative",
    "aec",
    "floor-plan",
    "pdf",
    "pdf-markup",
    "pdf-annotations",
    "measurement",
    "dxf",
    "cad",
    "ocr",
    "computer-vision",
    "symbol-detection",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "cli",
    "local-first"
  ],
  "license": "Apache-2.0",
  "homepage": "https://pdf2takeoff.com",
  "bugs": {
    "url": "https://github.com/ajflow/pdf2takeoff/issues"
  },
  "mcpName": "io.github.ajflow/pdf2takeoff",
  "overrides": {
    "pdfjs-dist": {
      "@napi-rs/canvas": "1.0.11"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ajflow/pdf2takeoff"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "1.0.11",
    "js-yaml": "^5.5.0",
    "libheif-js": "1.23.5",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "tesseract.js": "^7.0.0",
    "utif": "3.1.0",
    "xlsx": "^0.18.5",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
