{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.ajflow/pdf2takeoff",
  "description": "Construction takeoff from PDF drawings: scale, lengths, areas, counts. Runs locally.",
  "repository": { "url": "https://github.com/ajflow/pdf2takeoff", "source": "github" },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pdf2takeoff",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
